# ── SAK-Geo Environment ─────────────────────────────────────────────────────
# Copy to .env and fill in your values

# Mapbox (required for map rendering)
VITE_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token_here

# Sentinels Core API (required for project/device data)
VITE_CORE_API_URL=https://core.sentinels.pro/api/v1

# Ports
SAK_GEO_PORT=8080
